# Input data: only the files listed here are tracked
data/*
!data/README.md
!data/Analyisis/
data/Analyisis/*
!data/Analyisis/Metadata.xlsx

# Results, caches and R session files
results/*
*.RData
*.rds
.Rhistory
.Rproj.user/
*.html

# xlsx is ignored, except the summary-level Source Data
*.xlsx
!*/Source_data/*.xlsx
!data/Analyisis/Metadata.xlsx
